pub fn permutation(s: S) -> S {
    let mut s = external(s);
    for c in EXT_INIT.span() {
        s = ext_round(s, *c);
    }
    s = reduce64(s);
    for c in INT_GROUPS.span() {
        s = int_group(s, *c);
    }
    let [c20, c21] = INT_LAST;
    s = reduce128(int_round(int_round(s, c20), c21));
    for c in EXT_FINAL.span() {
        s = ext_round(s, *c);
    }
    reduce64(s)
}
