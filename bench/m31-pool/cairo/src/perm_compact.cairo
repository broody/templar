    external([sbox(s0 + c0), sbox(s1 + c1), sbox(s2 + c2), sbox(s3 + c3), sbox(s4 + c4), sbox(s5 + c5), sbox(s6 + c6), sbox(s7 + c7), sbox(s8 + c8), sbox(s9 + c9), sbox(s10 + c10), sbox(s11 + c11), sbox(s12 + c12), sbox(s13 + c13), sbox(s14 + c14), sbox(s15 + c15), sbox(s16 + c16), sbox(s17 + c17), sbox(s18 + c18), sbox(s19 + c19), sbox(s20 + c20), sbox(s21 + c21), sbox(s22 + c22), sbox(s23 + c23)])
}

#[inline(always)]
fn int_round(s: S, c: felt252) -> S {
    let [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23] = s;
