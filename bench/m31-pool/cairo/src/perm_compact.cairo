// Width-24 Poseidon2-M31 (Plonky3 Mersenne31, 8 full + 22 partial rounds, x^5) with lazy reduction.
// Rounds share code over constant tables: one full-round function (8 calls) and one group of four
// partial rounds (5 calls, plus the last two). The fully unrolled form made the pool class 3.5B
// L2 gas to declare; grouping keeps the per-call state passing small next to the rounds. Generated in the Cairo performance review (client-port/reviews/cairo-perf-review.md,
// Q4) from bench/m31-private-blake/client/src/{hash,constants}.rs; checked here against the client.

use stwo_verifier_core::fields::m31::M31Trait;

pub type S = [felt252; 24];

#[inline(always)]
fn r128(x: felt252) -> felt252 {
    let v: u128 = x.try_into().unwrap();
    M31Trait::reduce_u128(v).into()
}

#[inline(always)]
fn r64(x: felt252) -> felt252 {
    let v: u64 = x.try_into().unwrap();
    M31Trait::reduce_u64(v).into()
}

#[inline(always)]
fn sbox_wide(x: felt252) -> felt252 {
    let r = r128(x);
    let r2 = r64(r * r);
    r128(r2 * r2 * r)
}

#[inline(always)]
fn sbox(x: felt252) -> felt252 {
    // x < 2^40: x^2 < 2^80, r2^2 * x < 2^102.
    let r2 = r128(x * x);
    r128(r2 * r2 * x)
}

