}

/// Four partial rounds, then a reduction: the lazy-reduction group. One call per group keeps the
/// per-call cost of passing the state small next to the rounds.
fn int_group(s: S, c: [felt252; 4]) -> S {
    let [c0, c1, c2, c3] = c;
    reduce128(int_round(int_round(int_round(int_round(s, c0), c1), c2), c3))
}

