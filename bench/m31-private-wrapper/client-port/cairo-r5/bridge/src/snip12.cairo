//! The spend message a bound account signs (`docs/account-bound-note-spec.md` §5.3): SNIP-12
//! revision 1, built entirely from statement fields, with the binding salted.
//!
//! ```text
//! StarknetDomain { name: 'Templar', version: 'V5', chainId: <chain>, revision: 1 }
//! TemplarSpend { pool, binding_commitment = Poseidon(binding, salt), token_out,
//!                withdrawal_recipient, withdrawal_amount, intent }
//! hash = Poseidon('StarkNet Message', domain_hash, account, struct_hash)
//! ```
//!
//! The reference encoding is starknet.js 10.8 `typedData.getMessageHash` (known-answer vectors
//! in `snip12_kat.cairo`, generated by `kat/gen_snip12_kat.cjs`).
use core::poseidon::poseidon_hash_span;

pub const STARKNET_MESSAGE: felt252 = 'StarkNet Message';

/// sn_keccak of `"StarknetDomain"("name":"shortstring","version":"shortstring",
/// "chainId":"shortstring","revision":"shortstring")`.
pub const STARKNET_DOMAIN_TYPE_HASH: felt252 =
    0x1ff2f602e42168014d405a94f75e8a93d640751d71d16311266e140d8b0a210;

/// sn_keccak of `"TemplarSpend"("pool":"ContractAddress","binding_commitment":"felt",
/// "token_out":"ContractAddress","withdrawal_recipient":"ContractAddress",
/// "withdrawal_amount":"u128","intent":"felt")`.
pub const TEMPLAR_SPEND_TYPE_HASH: felt252 =
    0x26f4b4434596eda927640d80fc0e5f4e6d80e82289e112d306843f5e9df3873;

pub const DOMAIN_NAME: felt252 = 'Templar';
/// Non-numeric, so no wallet encodes it as a number (P0b S1).
pub const DOMAIN_VERSION: felt252 = 'V5';
/// Revision 1; starknet.js encodes the string '1' as the number 1.
pub const DOMAIN_REVISION: felt252 = 1;

/// The Templar domain's struct hash on `chain` (the statement's chain, a shortstring).
pub fn domain_hash(chain: felt252) -> felt252 {
    poseidon_hash_span([STARKNET_DOMAIN_TYPE_HASH, DOMAIN_NAME, DOMAIN_VERSION, chain, DOMAIN_REVISION].span())
}

/// `Poseidon(binding, salt)`: commits to the binding, and so to `valid_until`, without letting a
/// party that sees the typed data match the spend on chain.
pub fn binding_commitment(binding: felt252, salt: felt252) -> felt252 {
    poseidon_hash_span([binding, salt].span())
}

/// The `TemplarSpend` struct hash (members in declaration order; `u128` as a felt).
pub fn spend_struct_hash(
    pool: felt252,
    binding_commitment: felt252,
    token_out: felt252,
    withdrawal_recipient: felt252,
    withdrawal_amount: u128,
    intent: felt252,
) -> felt252 {
    poseidon_hash_span(
        [
            TEMPLAR_SPEND_TYPE_HASH, pool, binding_commitment, token_out, withdrawal_recipient,
            withdrawal_amount.into(), intent,
        ]
            .span(),
    )
}

/// The hash `account` signs for a spend: every field from the statement, the salt from the
/// client.
pub fn spend_message_hash(
    chain: felt252,
    account: felt252,
    pool: felt252,
    binding: felt252,
    salt: felt252,
    token_out: felt252,
    withdrawal_recipient: felt252,
    withdrawal_amount: u128,
    intent: felt252,
) -> felt252 {
    let struct_hash = spend_struct_hash(
        pool, binding_commitment(binding, salt), token_out, withdrawal_recipient, withdrawal_amount, intent,
    );
    poseidon_hash_span([STARKNET_MESSAGE, domain_hash(chain), account, struct_hash].span())
}
