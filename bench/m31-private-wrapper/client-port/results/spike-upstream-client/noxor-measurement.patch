+/// MEASUREMENT-ONLY PATCH (templar spike): proves and natively verifies an Eq + QM31-ops-only
+/// circuit (preprocessed with TEMPLAR_NOXOR). Not compatible with any deployed verifier.
+pub fn prove_and_verify_noxor<MC>(
+    preprocessed_circuit: &PreprocessedCircuit,
+    values: &[QM31],
+    pcs_config: PcsConfig,
+    max_fri_columns: Option<usize>,
+) -> Result<usize, ProvingError>
+where
+    MC: MerkleChannel,
+    SimdBackend: stwo::prover::backend::BackendForChannel<MC>,
+{
+    use crate::circuit_air::components::{eq, qm31_ops};
+    use crate::witness::trace::{write_interaction_trace_noxor, write_trace_noxor};
+    use stwo::core::air::Component;
+    use stwo_constraint_framework::TraceLocationAllocator;
+    let trace_log_size = preprocessed_circuit.trace_log_size;
+    let pcs_config = PcsConfig {
+        lifting_log_size: Some(trace_log_size + pcs_config.fri_config.log_blowup_factor),
+        ..pcs_config
+    };
+    let twiddles = SimdBackend::precompute_twiddles(
+        CanonicCoset::new(trace_log_size + std::cmp::max(pcs_config.fri_config.log_blowup_factor, COMPOSITION_POLYNOMIAL_LOG_DEGREE_BOUND))
+            .circle_domain()
+            .half_coset,
+    );
+    let pool = BaseColumnPool::<SimdBackend>::new();
+    let pp = &preprocessed_circuit.preprocessed_trace;
+    let pp_polys = SimdBackend::interpolate_columns(pp.get_trace::<SimdBackend>(), &twiddles);
+    let pp_tree = CommitmentTreeProver::<SimdBackend, MC>::new(
+        pp_polys, pcs_config.fri_config.log_blowup_factor, &twiddles, true, pcs_config.lifting_log_size, &pool,
+    );
+    let trace_generator = TraceGenerator {
+        qm31_ops_trace_generator: Qm31OpsTraceGenerator {
+            first_permutation_row: preprocessed_circuit.first_permutation_row,
+        },
+    };
+    let channel = &mut MC::C::default();
+    channel.mix_felts(&[0_u32.into()]);
+    pcs_config.mix_into(channel);
+    let mut scheme = CommitmentSchemeProver::<SimdBackend, MC>::with_memory_pool(pcs_config, &twiddles, &pool);
+    if let Some(k) = max_fri_columns {
+        scheme.set_bounded_memory_mode(k);
+    }
+    scheme.set_store_polynomials_coefficients();
+    scheme.commit_tree(MaybeOwned::Owned(pp_tree), channel);
+    let mut tb = scheme.tree_builder();
+    let (claim, log_sizes, lookup) =
+        write_trace_noxor(values, pp.clone(), preprocessed_circuit.n_outputs, &mut tb, &trace_generator, &twiddles);
+    claim.mix_into(channel);
+    tb.commit(channel);
+    let nonce = SimdBackend::grind(channel, INTERACTION_POW_BITS);
+    channel.mix_u64(nonce);
+    let elements = CircuitInteractionElements::draw(channel);
+    let mut tb = scheme.tree_builder();
+    let sums = write_interaction_trace_noxor(log_sizes, lookup, &mut tb, &elements, &twiddles);
+    let mut all = [QM31::zero(); circuit_verifier::circuit_components::N_COMPONENTS];
+    all[0] = sums[0];
+    all[1] = sums[1];
+    let interaction_claim = circuit_verifier::circuit_claim::CircuitInteractionClaim { claimed_sums: all };
+    assert_eq!(lookup_sum(&claim, &interaction_claim, &elements), QM31::zero());
+    interaction_claim.mix_into(channel);
+    tb.commit(channel);
+    let make = || {
+        let alloc = &mut TraceLocationAllocator::new_with_preprocessed_columns(&pp.ids());
+        let e = eq::Component::new(alloc, eq::Eval { log_size: log_sizes[0], common_lookup_elements: elements.common_lookup_elements.clone() }, sums[0]);
+        let q = qm31_ops::Component::new(alloc, qm31_ops::Eval { log_size: log_sizes[1], common_lookup_elements: elements.common_lookup_elements.clone() }, sums[1]);
+        (e, q)
+    };
+    let (e, q) = make();
+    let provers: Vec<&dyn ComponentProver<SimdBackend>> = vec![&e, &q];
+    let proof = prove_ex::<SimdBackend, _>(&provers, channel, scheme, true)?;
+    let proof_bytes = 0;
+
+    // Native verification of the same two-component statement.
+    let v = &mut MC::C::default();
+    v.mix_felts(&[0_u32.into()]);
+    pcs_config.mix_into(v);
+    let mut vs = stwo::core::pcs::CommitmentSchemeVerifier::<MC>::new(pcs_config);
+    let (e, q) = make();
+    let comps: Vec<&dyn Component> = vec![&e, &q];
+    let sizes = stwo::core::pcs::TreeVec::concat_cols(comps.iter().map(|c| c.trace_log_degree_bounds()));
+    let pp_sizes: Vec<u32> = pp.log_sizes().values().copied().collect();
+    vs.commit(proof.proof.commitments[0], &pp_sizes, v);
+    claim.mix_into(v);
+    vs.commit(proof.proof.commitments[1], &sizes[1], v);
+    v.mix_u64(nonce);
+    let _ = CircuitInteractionElements::draw(v);
+    interaction_claim.mix_into(v);
+    vs.commit(proof.proof.commitments[2], &sizes[2], v);
+    stwo::core::verifier::verify_ex(&comps, v, &mut vs, proof.proof, true).expect("noxor proof verifies");
+    Ok(proof_bytes)
+}
