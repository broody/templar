+/// MEASUREMENT-ONLY PATCH (templar spike): Eq and QM31 ops only.
+pub fn write_trace_noxor<MC: MerkleChannel>(
+    context_values: &[QM31],
+    preprocessed_trace: Arc<PreProcessedTrace>,
+    n_outputs: usize,
+    tree_builder: &mut TreeBuilder<'_, '_, SimdBackend, MC>,
+    trace_generator: &TraceGenerator,
+    twiddles: &TwiddleTree<SimdBackend>,
+) -> (CircuitClaim, [u32; 2], (eq::LookupData, qm31_ops::LookupData))
+where
+    SimdBackend: BackendForChannel<MC>,
+{
+    let pp = preprocessed_trace.as_ref();
+    let (eq_trace, eq_log_size, eq_lookup) = eq::write_trace(context_values, pp);
+    let eq_polys = SimdBackend::interpolate_columns(eq_trace.to_evals(), twiddles);
+    let (qm_trace, qm_log_size, qm_lookup) =
+        qm31_ops::write_trace(context_values, pp, &trace_generator.qm31_ops_trace_generator);
+    let qm_polys = SimdBackend::interpolate_columns(qm_trace.to_evals(), twiddles);
+    tree_builder.extend_polys(eq_polys);
+    tree_builder.extend_polys(qm_polys);
+    let output_values = ((U_VAR_IDX + 1)..(U_VAR_IDX + 1 + n_outputs))
+        .map(|addr| context_values[addr])
+        .collect_vec();
+    (CircuitClaim { output_values }, [eq_log_size, qm_log_size], (eq_lookup, qm_lookup))
+}
+
+/// MEASUREMENT-ONLY PATCH (templar spike): interaction trace for Eq and QM31 ops only.
+pub fn write_interaction_trace_noxor<MC: MerkleChannel>(
+    log_sizes: [u32; 2],
+    lookup: (eq::LookupData, qm31_ops::LookupData),
+    tree_builder: &mut TreeBuilder<'_, '_, SimdBackend, MC>,
+    interaction_elements: &CircuitInteractionElements,
+    twiddles: &TwiddleTree<SimdBackend>,
+) -> [QM31; 2]
+where
+    SimdBackend: BackendForChannel<MC>,
+{
+    let (t, eq_sum) = eq::write_interaction_trace(log_sizes[0], lookup.0, &interaction_elements.common_lookup_elements);
+    tree_builder.extend_polys(SimdBackend::interpolate_columns(t, twiddles));
+    let (t, qm_sum) = qm31_ops::write_interaction_trace(log_sizes[1], lookup.1, &interaction_elements.common_lookup_elements);
+    tree_builder.extend_polys(SimdBackend::interpolate_columns(t, twiddles));
+    [eq_sum, qm_sum]
+}
