+    #[cfg(feature = "parallel")]
+    let iter = indices.par_iter();
+    #[cfg(not(feature = "parallel"))]
+    let iter = indices.iter();
+    iter.map(|&i| {
+        let poly = &polynomials[i];
+        poly.get_evaluation_on_domain(poly.committed_domain, twiddles).values
+    })
