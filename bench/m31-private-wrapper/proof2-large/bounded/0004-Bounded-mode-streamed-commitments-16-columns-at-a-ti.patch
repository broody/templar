+/// The committed evaluations of `polynomials[indices]`, in that order, regenerated from
+/// coefficients (in parallel across the requested columns).
+fn evaluate_columns<B: crate::prover::backend::Backend>(
+    polynomials: &[Poly<B>],
+    indices: &[usize],
+    twiddles: &TwiddleTree<B>,
