+                        let v = (i.wrapping_mul(2654435761).wrapping_add(c as u32 * 40503)) % (1 << 31);
+                        M31::from_u32_unchecked(if i % 29 == 3 { 0 } else { v })
+                    })
+                    .collect()
+            })
+            .collect();
+        let simd_columns: Vec<BaseColumn> =
+            columns.iter().map(|c| c.iter().copied().collect()).collect();
+        let sorted_cpu = columns.iter().sorted_by_key(|c| c.len()).collect_vec();
+        let sorted_simd = simd_columns.iter().sorted_by_key(|c| c.len()).collect_vec();
+        let cpu_leaves = <CpuBackend as MerkleOpsLifted<Blake2sMerkleHasher>>::build_leaves(
+            &sorted_cpu,
