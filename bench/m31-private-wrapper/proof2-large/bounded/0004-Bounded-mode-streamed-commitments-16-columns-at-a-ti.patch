diff --git a/crates/stwo/src/prover/backend/simd/blake2s_lifted.rs b/crates/stwo/src/prover/backend/simd/blake2s_lifted.rs
index 835b2f1f3..1a3ec7a98 100644
--- a/crates/stwo/src/prover/backend/simd/blake2s_lifted.rs
+++ b/crates/stwo/src/prover/backend/simd/blake2s_lifted.rs
@@ -34,6 +34,88 @@ const N_BYTES_IN_BLAKE_MESSAGE: u64 = N_FELTS_IN_BLAKE_MESSAGE as u64 * N_BYTES_
 const LOG_N_HASHES_PER_SIMD_STATE: u32 = 4;
 
 impl MerkleOpsLifted<Blake2sMerkleHasher> for SimdBackend {
+    /// Streams columns 16 at a time (one Blake2s message block per leaf) in increasing size
+    /// order, holding one packed hash state per 16 rows instead of every column. Each block's
+    /// columns are dropped before the next block is requested. Leaves equal [`Self::build_leaves`]
+    /// over the size-sorted columns.
+    fn build_leaves_with_column_provider(
+        column_log_sizes: &[u32],
+        lifting_log_size: u32,
+        get_columns: &mut dyn FnMut(&[usize]) -> Vec<BaseColumn>,
+    ) -> Vec<Blake2sHash> {
+        if column_log_sizes.is_empty() {
+            return vec![Blake2sMerkleHasher::default().finalize()];
+        }
+        assert!(
+            column_log_sizes.iter().all(|&log_size| log_size > 0 && log_size <= lifting_log_size),
+            "column sizes must lie in 1..=lifting_log_size"
+        );
+        let mut indices: Vec<usize> = (0..column_log_sizes.len()).collect();
+        indices.sort_by_key(|&index| column_log_sizes[index]);
+
+        // A packed state holds 16 leaf hash states. It grows only when the next block needs more
+        // rows. Below 16 rows the extra lanes repeat the logical domain and are discarded.
+        let mut state_log_size = lifting_log_size.min(LOG_N_LANES);
+        let mut states = vec![INITIAL_STATE];
+        let mut byte_count = 0_u64;
+        for (block_index, block_indices) in indices.chunks(N_FELTS_IN_BLAKE_MESSAGE).enumerate() {
+            let columns = get_columns(block_indices);
+            assert_eq!(columns.len(), block_indices.len());
+            for (column, &index) in columns.iter().zip(block_indices) {
+                assert_eq!(column.len(), 1 << column_log_sizes[index]);
+            }
+            let next_log_size = state_log_size.max(column_log_sizes[*block_indices.last().unwrap()]);
+            if next_log_size > state_log_size {
+                let log_ratio = next_log_size - state_log_size;
+                states = (0..1 << (next_log_size - LOG_N_LANES))
+                    .map(|i| array::from_fn(|j| to_lifted_simd(states[i >> log_ratio][j], log_ratio, i)))
+                    .collect();
+                state_log_size = next_log_size;
+            }
+            byte_count += (columns.len() * N_BYTES_FELT) as u64;
+            let final_block = (block_index + 1) * N_FELTS_IN_BLAKE_MESSAGE >= indices.len();
+            #[cfg(not(feature = "parallel"))]
+            let iter = states.iter_mut();
+            #[cfg(feature = "parallel")]
+            let iter = states.par_iter_mut();
+            iter.enumerate().for_each(|(i, state)| {
+                let msgs = array::from_fn(|j| {
+                    if j < columns.len() {
+                        streamed_column_message(&columns[j], column_log_sizes[block_indices[j]], state_log_size, i)
+                    } else {
+                        u32x16::splat(0)
+                    }
+                });
+                *state = if final_block {
+                    compress_finalize(*state, msgs, byte_count)
+                } else {
+                    compress_unfinalized(*state, msgs, byte_count)
+                };
+            });
+            // This block's columns are dropped here, before the next block is requested.
+        }
+
+        // Lift straight into the output hashes, without a second full-height state buffer.
+        let log_ratio = lifting_log_size - state_log_size;
+        let mut result = vec![Blake2sHash::default(); 1 << lifting_log_size];
+        #[cfg(not(feature = "parallel"))]
+        let iter = result.chunks_mut(N_LANES);
+        #[cfg(feature = "parallel")]
+        let iter = result.par_chunks_mut(N_LANES);
+        iter.enumerate().for_each(|(i, dst)| {
+            let state: [u32x16; N_FELTS_IN_BLAKE_STATE] =
+                array::from_fn(|j| to_lifted_simd(states[i >> log_ratio][j], log_ratio, i));
+            let words = untranspose_states(state).map(|word| word.to_array());
+            for (hash_index, hash) in dst.iter_mut().enumerate() {
+                hash.0 = array::from_fn(|byte_index| {
+                    let word_index = hash_index * N_FELTS_IN_BLAKE_STATE + byte_index / 4;
+                    words[word_index / N_LANES][word_index % N_LANES].to_le_bytes()[byte_index % 4]
+                });
+            }
+        });
+        result
+    }
+
     /// See the docs of [`crate::prover::backend::cpu::blake2s_lifted`].
     ///
     /// This function assumes that `columns` is sorted increasingly by column length.
@@ -260,6 +342,26 @@ impl MerkleOpsLifted<Blake2sMerkleHasher> for SimdBackend {
     }
 }
 
+
+/// One packed message word for leaf rows `16·packed_row ..`: the column's values lifted to the
+/// state height with the same pair-preserving lift as the ordinary commitment.
+fn streamed_column_message(
+    column: &BaseColumn,
+    column_log_size: u32,
+    logical_log_size: u32,
+    packed_row: usize,
+) -> u32x16 {
+    let log_ratio = logical_log_size - column_log_size;
+    if column_log_size >= LOG_N_LANES {
+        to_lifted_simd(column.data[packed_row >> log_ratio].into_simd(), log_ratio, packed_row)
+    } else {
+        u32x16::from_array(array::from_fn(|lane| {
+            let row = (packed_row * N_LANES + lane) % (1 << logical_log_size);
+            // The raw representation, as the ordinary CPU fallback reads it.
+            column.as_slice()[(row >> (log_ratio + 1) << 1) + (row & 1)].0
+        }))
+    }
+}
 impl PackLeavesOps for SimdBackend {
     fn pack_leaves_input(
