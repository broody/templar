+#[cfg(test)]
+mod bounded_tests {
+    use stwo::core::channel::Blake2sM31Channel;
+    use stwo::core::fri::FriConfig;
+    use stwo::core::pcs::{CommitmentSchemeVerifier, PcsConfig};
+    use stwo::core::utils::bit_reverse_index;
+    use stwo::core::vcs_lifted::blake2_merkle::Blake2sM31MerkleChannel;
+    use stwo::core::verifier::verify;
+    use stwo::prover::backend::{BackendForChannel, Column};
+    use stwo::prover::poly::circle::CircleCoefficients;
+    use stwo::prover::{CommitmentSchemeProver, prove};
+
+    use crate::{EvalAtRow, TraceLocationAllocator};
+
+    #[derive(Clone)]
+    struct OffsetEval {
+        log_size: u32,
+    }
+
+    impl FrameworkEval for OffsetEval {
+        fn log_size(&self) -> u32 {
+            self.log_size
+        }
+        fn max_constraint_log_degree_bound(&self) -> u32 {
+            self.log_size + 1
+        }
+        fn evaluate<E: EvalAtRow>(&self, mut eval: E) -> E {
+            let [previous, _, next] = eval.next_interaction_mask(1, [-1, 0, 1]);
+            let next_square = eval.next_trace_mask();
+            let previous_square = eval.next_trace_mask();
+            eval.add_constraint(next.clone() * next - next_square);
+            eval.add_constraint(previous.clone() * previous - previous_square);
+            eval
+        }
+    }
+
+    fn check_offset_stark<B: BackendForChannel<Blake2sM31MerkleChannel>>()
+    where
+        FrameworkComponent<OffsetEval>: ComponentProver<B>,
+    {
+        for log_size in [3, 6] {
+            // The preprocessed tree is empty, so upstream requires it lifted to height 0.
+            let config = PcsConfig {
+                preprocessed_lifting_log_size: 0,
+                ..PcsConfig::from_fri_and_trace_size(FriConfig::new(4, 0, 3, 3, 1), log_size)
+            };
+            let twiddles = B::precompute_twiddles(CanonicCoset::new(log_size + 4).half_coset());
+            let trace_domain = CanonicCoset::new(log_size).circle_domain();
+            let values = (0..1 << log_size)
+                .map(|row| BaseField::from((row * row + row * 7 + 3) as u32))
+                .collect_vec();
+            let points = (0..1 << log_size)
+                .map(|row| trace_domain.at(bit_reverse_index(row, log_size)))
+                .collect_vec();
+            let make_trace = || {
+                [0, 1, -1]
+                    .into_iter()
+                    .map(|offset| {
+                        let column = (0..values.len())
+                            .map(|row| {
+                                if offset == 0 {
+                                    values[row]
+                                } else {
+                                    let shifted = points[row]
+                                        + CanonicCoset::new(log_size).step().mul_signed(offset);
+                                    let value = values[points
+                                        .iter()
+                                        .position(|point| *point == shifted)
+                                        .unwrap()];
+                                    value * value
+                                }
+                            })
+                            .collect();
+                        CircleEvaluation::<B, _, BitReversedOrder>::new(trace_domain, column)
+                    })
+                    .collect_vec()
+            };
+            let component = FrameworkComponent::new(
+                &mut TraceLocationAllocator::default(),
+                OffsetEval { log_size },
+                SecureField::from(0),
+            );
+            let run = |bounded: bool| {
+                let mut channel = Blake2sM31Channel::default();
+                let mut scheme =
+                    CommitmentSchemeProver::<B, Blake2sM31MerkleChannel>::new(config, &twiddles);
+                scheme.set_store_polynomials_coefficients();
+                if bounded {
+                    scheme.set_bounded_memory_mode(1);
+                }
+                scheme.tree_builder().commit(&mut channel);
+                let mut builder = scheme.tree_builder();
+                builder.extend_evals(make_trace());
+                builder.commit(&mut channel);
+                prove::<B, Blake2sM31MerkleChannel>(&[&component], &mut channel, scheme).unwrap()
+            };
+            let baseline = run(false);
+            let bounded = run(true);
+            assert_eq!(format!("{baseline:?}"), format!("{bounded:?}"));
+            let mut channel = Blake2sM31Channel::default();
+            let mut verifier = CommitmentSchemeVerifier::<Blake2sM31MerkleChannel>::new(config);
+            let sizes = component.trace_log_degree_bounds();
+            verifier.commit(bounded.commitments[0], &sizes[0], &mut channel);
+            verifier.commit(bounded.commitments[1], &sizes[1], &mut channel);
+            verify(&[&component], &mut channel, &mut verifier, bounded).unwrap();
+        }
+    }
+
+    #[test]
+    fn bounded_offset_stark_cpu() {
+        check_offset_stark::<CpuBackend>();
+    }
+
+    #[test]
+    fn bounded_offset_stark_simd() {
+        check_offset_stark::<SimdBackend>();
+    }
+
+    use super::*;
+
+    fn check_component_columns<B: Backend>() {
+        // Mixed committed heights deliberately exercise the per-column prefix fallback;
+        // small requested domains also exercise prefixes shorter than the coefficient vector.
+        let coefficients = [3, 4, 6]
+            .into_iter()
+            .map(|log_size| {
+                CircleCoefficients::<B>::new(
+                    (0..1 << log_size).map(|row| BaseField::from((row * 11 + 7) as u32)).collect(),
+                )
+            })
+            .collect_vec();
+        let mut polynomials = coefficients
+            .into_iter()
+            .map(|coefficients| {
+                let domain = CanonicCoset::new(coefficients.log_size() + 3).circle_domain();
+                let evaluations = coefficients.evaluate(domain);
+                Poly::new(Some(coefficients), evaluations)
+            })
+            .collect_vec();
+        for eval_log_size in [2, 4, 6] {
+            let eval_domain = subdomain_eval_domain(eval_log_size, 2);
+            let expected = {
+                let refs = polynomials.iter().collect_vec();
+                let columns = get_trace_columns(
+                    TreeVec(vec![refs.iter().collect()]),
+                    eval_domain,
+                    EvaluationMode::SubDomain { log_expansion: 2 },
+                );
+                columns[0]
+                    .iter()
+                    .map(|column| column.values.to_cpu()[..1 << eval_log_size].to_vec())
+                    .collect_vec()
+            };
+            // Temporarily take evaluations to exercise the exact coefficient-backed path.
+            let cached = polynomials.iter_mut().map(|poly| poly.evals.take()).collect_vec();
+            let refs = polynomials.iter().collect_vec();
+            let columns = get_trace_columns(
+                TreeVec(vec![refs.iter().collect()]),
+                eval_domain,
+                EvaluationMode::SubDomain { log_expansion: 2 },
+            );
+            assert_eq!(
+                columns[0].iter().map(|column| column.values.to_cpu()).collect_vec(),
+                expected
+            );
+            drop(columns);
+            for (poly, evaluations) in polynomials.iter_mut().zip(cached) {
+                poly.evals = evaluations;
+            }
+        }
+        // ExtendToEvalDomain must continue to evaluate the same polynomial, irrespective of
+        // whether the committed LDE happens to be retained.
+        let eval_domain = CanonicCoset::new(8).circle_domain();
+        let expected = {
+            let refs = polynomials.iter().collect_vec();
+            get_trace_columns(
+                TreeVec(vec![refs.iter().collect()]),
+                eval_domain,
+                EvaluationMode::ExtendToEvalDomain,
+            )[0]
+            .iter()
+            .map(|column| column.values.to_cpu())
+            .collect_vec()
+        };
+        polynomials.iter_mut().for_each(Poly::evict_evaluations);
+        let refs = polynomials.iter().collect_vec();
+        let actual = get_trace_columns(
+            TreeVec(vec![refs.iter().collect()]),
+            eval_domain,
+            EvaluationMode::ExtendToEvalDomain,
+        );
+        assert_eq!(actual[0].iter().map(|column| column.values.to_cpu()).collect_vec(), expected);
+    }
+
+    #[test]
+    fn bounded_component_columns_cpu() {
+        check_component_columns::<CpuBackend>();
+    }
+
+    #[test]
+    fn bounded_component_columns_simd() {
+        check_component_columns::<SimdBackend>();
+    }
+}
