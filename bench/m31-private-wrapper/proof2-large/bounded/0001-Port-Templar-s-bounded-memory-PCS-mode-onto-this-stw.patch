+    /// Recreates a prefix of the committed bit-reversed evaluation vector. A requested domain
+    /// smaller than the coefficient vector is handled by evaluating on the full committed
+    /// domain first; coefficients are never truncated to fit a smaller FFT.
+    pub fn get_evaluation_on_prefix(
+        &self,
+        domain: CircleDomain,
+        twiddles: &TwiddleTree<B>,
+    ) -> CircleEvaluation<B, BaseField, BitReversedOrder> {
+        let log_split = self
+            .committed_domain
+            .log_size()
+            .checked_sub(domain.log_size())
+            .expect("Requested prefix exceeds the committed domain");
+        assert_eq!(self.committed_domain.split(log_split).0, domain);
+        if self.coeffs.as_ref().expect("Prefix regeneration requires coefficients").log_size()
+            <= domain.log_size()
+        {
+            return self.get_evaluation_on_domain(domain, twiddles);
+        }
+        let full_twiddles = B::precompute_twiddles(self.committed_domain.half_coset);
+        let full = self.get_evaluation_on_domain(self.committed_domain, &full_twiddles);
+        CircleEvaluation::new(domain, (0..domain.size()).map(|row| full.values.at(row)).collect())
+    }
 }
 
