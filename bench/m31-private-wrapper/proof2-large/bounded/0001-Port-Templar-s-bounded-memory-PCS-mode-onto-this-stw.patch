diff --git a/crates/circuit_prover/src/prover_test.rs b/crates/circuit_prover/src/prover_test.rs
index b956c7fd6..8b1d2beed 100644
--- a/crates/circuit_prover/src/prover_test.rs
+++ b/crates/circuit_prover/src/prover_test.rs
@@ -469,3 +469,34 @@ fn test_pad_context() {
     assert!(qm31_ops.is_power_of_two());
     context.validate_circuit();
 }
+
+/// Bounded-memory proving is a storage policy only: the proof must equal the unbounded one field
+/// for field, and verify.
+#[test]
+fn test_bounded_memory_proof_is_identical() {
+    let mut context = build_fibonacci_context().finalize(false);
+    let preprocessed_circuit = PreprocessedCircuit::preprocess_circuit(&mut context);
+    let prove = |max_fri_columns| {
+        crate::prover::prove_circuit_assignment_bounded::<Blake2sM31MerkleChannel>(
+            context.values(),
+            &preprocessed_circuit,
+            &BaseColumnPool::<SimdBackend>::new(),
+            default_circuit_pcs_config(preprocessed_circuit.trace_log_size),
+            max_fri_columns,
+        )
+        .unwrap()
+    };
+    let unbounded = prove(None);
+    for max_fri_columns in [1, 16] {
+        let bounded = prove(Some(max_fri_columns));
+        // `aux` holds hash maps, whose Debug order varies; the proof proper must match exactly.
+        assert_eq!(
+            format!("{:?}", bounded.stark_proof.proof),
+            format!("{:?}", unbounded.stark_proof.proof)
+        );
+        assert_eq!(bounded.interaction_claim, unbounded.interaction_claim);
+        assert_eq!(bounded.claim, unbounded.claim);
+        assert_eq!(bounded.circuit_hash, unbounded.circuit_hash);
+        stwo_verify(bounded, &preprocessed_circuit);
+    }
+}
