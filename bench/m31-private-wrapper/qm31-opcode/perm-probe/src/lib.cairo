//! Poseidon2-M31 (width 24, 8 full + 22 partial rounds, x^5) over `stwo_verifier_core::M31`:
//! manual reductions by default, native `m31_ops` (the QM31 opcode) with feature `qm31_opcode`.
use stwo_verifier_core::fields::m31::{M31, M31Trait};

type S = [M31; 24];

fn m(v: felt252) -> M31 {
    let x: u32 = v.try_into().unwrap();
    M31Trait::reduce_u32(x)
}

#[inline(always)]
fn sbox(x: M31) -> M31 {
    let x2 = x * x;
    x2 * x2 * x
}

fn external(s: S) -> S {
    let arr = s.span();
    let two = m(2);
    let three = m(3);
    let mut t: Array<M31> = array![];
    for b in 0..6_u32 {
        let a0 = *arr.at(4 * b);
        let a1 = *arr.at(4 * b + 1);
        let a2 = *arr.at(4 * b + 2);
        let a3 = *arr.at(4 * b + 3);
        t.append(two * a0 + three * a1 + a2 + a3);
        t.append(a0 + two * a1 + three * a2 + a3);
        t.append(a0 + a1 + two * a2 + three * a3);
        t.append(three * a0 + a1 + a2 + two * a3);
    }
    let t = t.span();
    let mut u: Array<M31> = array![];
    for j in 0..4_u32 {
        u.append(*t.at(j) + *t.at(4 + j) + *t.at(8 + j) + *t.at(12 + j) + *t.at(16 + j) + *t.at(20 + j));
    }
    let u = u.span();
    let mut out: Array<M31> = array![];
    for i in 0..24_u32 {
        out.append(*t.at(i) + *u.at(i % 4));
    }
    (*out.span().try_into().unwrap()).unbox()
}

