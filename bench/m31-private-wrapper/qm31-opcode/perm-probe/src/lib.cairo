fn ext_round(s: S, c: [felt252; 24]) -> S {
    let c = c.span();
    let s = s.span();
    let mut out: Array<M31> = array![];
    for i in 0..24_u32 {
        out.append(sbox(*s.at(i) + m(*c.at(i))));
    }
    external((*out.span().try_into().unwrap()).unbox())
}

fn int_round(s: S, c: felt252) -> S {
    let s = s.span();
    let s0 = sbox(*s.at(0) + m(c));
    let mut sum = s0;
    for i in 1..24_u32 {
        sum = sum + *s.at(i);
    }
    let d = DIAG.span();
    let mut out: Array<M31> = array![sum + m(*d.at(0)) * s0];
    for i in 1..24_u32 {
        out.append(sum + m(*d.at(i)) * *s.at(i));
    }
    (*out.span().try_into().unwrap()).unbox()
}

pub fn permutation(s: S) -> S {
    let mut s = external(s);
    for c in EXT_INIT.span() {
        s = ext_round(s, *c);
    }
    for g in INT_GROUPS.span() {
        for c in g.span() {
            s = int_round(s, *c);
        }
    }
    for c in INT_LAST.span() {
        s = int_round(s, *c);
    }
    for c in EXT_FINAL.span() {
        s = ext_round(s, *c);
    }
    s
}

#[executable]
fn main(n: u32) -> Array<felt252> {
    let mut init: Array<M31> = array![];
    for i in 0..24_u32 {
        init.append(m(i.into()));
    }
    let mut s: S = (*init.span().try_into().unwrap()).unbox();
    for _ in 0..n {
        s = permutation(s);
    }
    let mut out = array![];
    for x in s.span() {
        let v: felt252 = (*x).inner.into();
        out.append(v);
    }
    out
}
